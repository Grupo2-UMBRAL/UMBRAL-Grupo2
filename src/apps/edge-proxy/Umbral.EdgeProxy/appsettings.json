{
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:3000"
  ],
  "ReverseProxy": {
    "Routes": {
      "identity-access": {
        "ClusterId": "identity-access",
        "Match": {
          "Path": "/identity-access/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity-access"
          }
        ]
      },
      "mission-management": {
        "ClusterId": "mission-management",
        "Match": {
          "Path": "/mission-management/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/mission-management"
          }
        ]
      },
      "session-management": {
        "ClusterId": "session-management",
        "Match": {
          "Path": "/session-management/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/session-management"
          }
        ]
      },
      "session-hub": {
        "ClusterId": "session-management",
        "Match": {
          "Path": "/session-hub/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/session-hub"
          }
        ]
      },
      "scoring-monitoring": {
        "ClusterId": "scoring-monitoring",
        "Match": {
          "Path": "/scoring-monitoring/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/scoring-monitoring"
          }
        ]
      },
      "auth": {
        "ClusterId": "keycloak",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "mobile": {
        "ClusterId": "mobile",
        "Match": {
          "Path": "/mobile/{**catch-all}"
        }
      },
      "mobile-expo-assets": {
        "ClusterId": "mobile",
        "Match": {
          "Path": "/_expo/{**catch-all}"
        }
      },
      "mobile-node-modules": {
        "ClusterId": "mobile",
        "Match": {
          "Path": "/node_modules/expo-router/{**catch-all}"
        }
      },
      "mobile-index-bundle": {
        "ClusterId": "mobile",
        "Match": {
          "Path": "/index.bundle"
        }
      },
      "web-fallback": {
        "ClusterId": "web",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-access": {
        "Destinations": {
          "primary": {
            "Address": "http://identity-access-service:8080/"
          }
        }
      },
      "mission-management": {
        "Destinations": {
          "primary": {
            "Address": "http://mission-management-service:8080/"
          }
        }
      },
      "session-management": {
        "Destinations": {
          "primary": {
            "Address": "http://session-management-service:8080/"
          }
        }
      },
      "scoring-monitoring": {
        "Destinations": {
          "primary": {
            "Address": "http://scoring-monitoring-service:8080/"
          }
        }
      },
      "keycloak": {
        "Destinations": {
          "primary": {
            "Address": "http://keycloak:8080/"
          }
        }
      },
      "mobile": {
        "Destinations": {
          "primary": {
            "Address": "http://mobile:19006/"
          }
        }
      },
      "web": {
        "Destinations": {
          "primary": {
            "Address": "http://web:3000/"
          }
        }
      }
    }
  }
}
