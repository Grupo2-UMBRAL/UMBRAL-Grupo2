{
  "expo": {
    "name": "UMBRAL Mobile",
    "slug": "umbral-mobile",
    "scheme": "umbralmobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UMBRAL usa tu ubicación para mostrarte en el mapa junto a la pista de la etapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
