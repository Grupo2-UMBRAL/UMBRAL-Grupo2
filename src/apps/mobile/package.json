{
  "name": "@umbral/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:expo-go": "expo start --lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:compose": "expo start --web --host localhost --port ${EXPO_PORT:-19006}",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web --output-dir dist",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@microsoft/signalr": "^10.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "buffer": "^6.0.3",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.7",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
