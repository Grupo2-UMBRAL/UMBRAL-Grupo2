<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Enables framework package pruning (in-box assemblies resolved from the shared
         framework), which keeps the vulnerable transitive System.Security.Cryptography.Xml
         out of the restore graph. Same pattern as the sibling Infrastructure projects. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MissionManagement.Application\MissionManagement.Application.csproj" />
    <ProjectReference Include="..\MissionManagement.Domain\MissionManagement.Domain.csproj" />
    <ProjectReference Include="..\..\..\shared\Umbral.ServiceDefaults\Umbral.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MissionManagement.IntegrationTests" />
  </ItemGroup>
</Project>