POSTGRES_DB=umbral
POSTGRES_USER=umbral
POSTGRES_PASSWORD=umbral
POSTGRES_PORT=5433

RABBITMQ_DEFAULT_USER=umbral
RABBITMQ_DEFAULT_PASS=umbral
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=16672

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=umbral

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Email / SMTP — Gmail example (use an App Password, not your account password)
# To generate an App Password: myaccount.google.com > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_ADDRESS=victorpabon88@gmail.com
SMTP_FROM_NAME=UMBRAL
SMTP_USE_SSL=false
SMTP_USERNAME=victorpabon88@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

EDGE_PROXY_PORT=7500

USER_MANAGEMENT_PORT=7100
MISSION_MANAGEMENT_PORT=7101
SESSION_OPERATIONS_PORT=7102
SCORING_MONITORING_PORT=7103

AUTH_AUTHORITY=http://keycloak:8080/auth/realms/umbral
AUTH_REQUIRE_HTTPS_METADATA=false
USER_MANAGEMENT_KEYCLOAK_BASE_URL=http://keycloak:8080/auth
USER_MANAGEMENT_KEYCLOAK_REALM=umbral
USER_MANAGEMENT_KEYCLOAK_ADMIN_REALM=master
USER_MANAGEMENT_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
USER_MANAGEMENT_KEYCLOAK_ADMIN_USERNAME=admin
USER_MANAGEMENT_KEYCLOAK_ADMIN_PASSWORD=admin
# Where Keycloak returns an Operator after they finish the onboarding actions
# (set password / complete profile / verify email). Must be whitelisted as a
# redirect URI on the umbral-web client. Deployed: use the public HTTPS web URL.
OPERATOR_ONBOARDING_REDIRECT_URI=http://localhost:3000

TEMPLATE_OUTPUT_DIR=/workspace/templates-output

WEB_PORT=3000
KEYCLOAK_WEB_CLIENT_ID=umbral-web
EDGE_PROXY_INTERNAL_BASE_URL=http://edge-proxy:8080
KEYCLOAK_INTERNAL_BASE_URL=http://edge-proxy:8080/auth
NEXT_PUBLIC_EDGE_PROXY_BASE_URL=http://localhost:7500
NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:7500/auth
NEXT_PUBLIC_SESSION_OPERATIONS_HUB_PATH=/session-hub/hubs/session
NEXT_PUBLIC_SCORING_MONITORING_HUB_PATH=/scoring-monitoring/hub/scoring
# Google Maps JavaScript API key for the hint location picker (Admin mission builder).
# PUBLIC: this key is embedded in the browser bundle — it is NOT a secret. Guard it
# in Google Cloud with an HTTP-referrer restriction and by enabling ONLY the
# "Maps JavaScript API" + "Places API". Billing must be enabled on the project.
# Leave empty to disable the map picker (the raw lat/lng number inputs still work).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

MOBILE_WEB_PORT=19600
MOBILE_EDGE_PROXY_BASE_URL=http://localhost:7500
MOBILE_KEYCLOAK_BASE_URL=http://localhost:7500/auth
MOBILE_KEYCLOAK_REALM=umbral
MOBILE_KEYCLOAK_CLIENT_ID=umbral-mobile
MOBILE_SESSION_OPERATIONS_HUB_PATH=/session-hub/hubs/session
MOBILE_SCORING_MONITORING_HUB_PATH=/scoring-monitoring/hub/scoring
