        "Operator"
      ]
    },
    {
      "username": "participant",
      "enabled": true,
      "email": "participant@umbral.local",
      "emailVerified": true,
      "firstName": "Participant",
      "lastName": "UMBRAL",
      "credentials": [
        {
          "type": "password",
          "value": "participant123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Participant"
      ]
    }
  ]
}
