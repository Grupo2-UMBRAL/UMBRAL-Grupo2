      "sessionManagement": "[format('{0}/umbral/session-management:{1}', variables('registryLoginServer'), parameters('imageTag'))]",
      "scoringMonitoring": "[format('{0}/umbral/scoring-monitoring:{1}', variables('registryLoginServer'), parameters('imageTag'))]",
      "web": "[format('{0}/umbral/web:{1}', variables('registryLoginServer'), parameters('imageTag'))]",
      "edgeProxy": "[format('{0}/umbral/edge-proxy:{1}', variables('registryLoginServer'), parameters('imageTag'))]"
    },
    "postgresConnectionSecrets": [
