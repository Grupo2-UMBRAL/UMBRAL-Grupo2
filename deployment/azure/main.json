      },
      {
        "name": "postgres-connection-mission-management",
        "value": "[format('Host={0};Port=5432;Database={1};Username={2};Password={3};SSL Mode=Require;Search Path=mission_management', parameters('postgresHost'), parameters('postgresDatabase'), parameters('postgresUser'), parameters('postgresPassword'))]"
