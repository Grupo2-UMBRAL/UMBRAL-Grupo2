    {
      "condition": "[parameters('deployContainerApps')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "rabbitmq",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "secrets": [
            {
              "name": "rabbitmq-password",
              "value": "[parameters('rabbitMqPassword')]"
            }
          ],
          "ingress": {
            "external": false,
            "targetPort": 5672,
            "exposedPort": 5672,
            "transport": "tcp"
          }
        },
        "template": {
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          },
          "containers": [
            {
              "name": "rabbitmq",
              "image": "[variables('imageNames').rabbitmq]",
              "env": [
                {
                  "name": "RABBITMQ_DEFAULT_USER",
                  "value": "[variables('rabbitMqUser')]"
                },
                {
                  "name": "RABBITMQ_DEFAULT_PASS",
                  "secretRef": "rabbitmq-password"
                },
                {
                  "name": "RABBITMQ_NODENAME",
                  "value": "rabbit@localhost"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]"
      ]
    },
    {
      "condition": "[parameters('deployContainerApps')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "keycloak",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName')), '2023-07-01').loginServer]",
              "username": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName')), '2023-07-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName')), '2023-07-01').passwords[0].value]"
            },
            {
              "name": "keycloak-admin-password",
              "value": "[parameters('keycloakAdminPassword')]"
            },
            {
              "name": "postgres-password",
              "value": "[parameters('postgresPassword')]"
            }
          ],
          "ingress": {
            "external": false,
            "targetPort": 8080,
            "transport": "http"
          }
        },
        "template": {
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          },
          "containers": [
            {
              "name": "keycloak",
              "image": "[variables('imageNames').keycloak]",
              "command": [
                "/opt/keycloak/bin/kc.sh"
              ],
              "args": [
                "start",
                "--import-realm",
                "--http-relative-path=/auth",
                "[format('--hostname={0}/auth', parameters('publicBaseUrl'))]",
                "--hostname-backchannel-dynamic=true"
              ],
              "env": [
                {
                  "name": "KEYCLOAK_ADMIN",
                  "value": "[variables('keycloakAdminUser')]"
                },
                {
                  "name": "KEYCLOAK_ADMIN_PASSWORD",
                  "secretRef": "keycloak-admin-password"
                },
                {
                  "name": "KC_DB",
                  "value": "postgres"
                },
                {
                  "name": "KC_DB_URL",
                  "value": "[format('jdbc:postgresql://{0}:5432/{1}?sslmode=require', parameters('postgresHost'), parameters('postgresDatabase'))]"
                },
                {
                  "name": "KC_DB_USERNAME",
                  "value": "[parameters('postgresUser')]"
                },
                {
                  "name": "KC_DB_PASSWORD",
                  "secretRef": "postgres-password"
                },
                {
                  "name": "KC_HTTP_ENABLED",
                  "value": "true"
                },
                {
                  "name": "KC_HEALTH_ENABLED",
                  "value": "true"
                },
                {
                  "name": "KC_PROXY_HEADERS",
                  "value": "xforwarded"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName'))]"
      ]
    },
    {
      "condition": "[parameters('deployContainerApps')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "user-management-service",
