        "name": "postgres-connection-session-management",
        "value": "[format('Host={0};Port=5432;Database={1};Username={2};Password={3};SSL Mode=Require;Search Path=session_management', parameters('postgresHost'), parameters('postgresDatabase'), parameters('postgresUser'), parameters('postgresPassword'))]"
      },
      {
        "name": "postgres-connection-scoring-monitoring",
        "value": "[format('Host={0};Port=5432;Database={1};Username={2};Password={3};SSL Mode=Require;Search Path=scoring_monitoring', parameters('postgresHost'), parameters('postgresDatabase'), parameters('postgresUser'), parameters('postgresPassword'))]"
